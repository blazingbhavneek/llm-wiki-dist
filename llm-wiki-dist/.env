# Project root containing mount/ raw/ wiki/ metadata/ (NOT data/raw itself)
WIKI_DATA_ROOT=/home/seigyo/c_repo/bhavneek/llm-wiki-neo/data

# Chat model (OpenAI-compatible /v1) — the only service wiki generation needs
OPENAI_BASE_URL=http://10.160.144.101:51029/v1
OPENAI_API_KEY=dummy
WIKI_MODEL=gemma-4-31B

# Writer mode
WIKI_INGEST_MODE=wiki
WIKI_OUTPUT_LANGUAGE="Japanese (日本語)"

# Section rewrite retries before a section falls back to verbatim source (default 3)
WIKI_WRITE_ATTEMPTS=6

# doc-parser service (repo root ./parser, port 8888). Needed for non-.md sources.
WIKI_PARSER_BASE_URL=http://127.0.0.1:8888
