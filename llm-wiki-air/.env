GROWI_WRITE_PATH=/
GROWI_ROOT_PATH=/
GROWI_MODE=attach
GROWI_TIMEOUT=30

WIKI_DATA_ROOT=./data
WIKI_PARSER_BASE_URL=http://10.160.144.101:51027/agent/doc-parser/
WIKI_CHAT_BASE_URL=http://162.43.170.108:27027/v1
OPENAI_BASE_URL=http://162.43.170.108:27027/v1
OPENAI_API_KEY=dummy
WIKI_MODEL=gemma-4-31B
WIKI_CHAT_MODEL=gemma-4-31B
WIKI_EMBED_BACKEND=off
WIKI_EMBED_BASE_URL=http://10.160.144.101:51024/v1
WIKI_EMBED_MODEL=cl-nagoya/ruri-v3-310m
WIKI_EMBED_DIM=768
WIKI_RERANK_BASE_URL=http://10.160.144.101:51025/v1
WIKI_RERANK_MODEL=cl-nagoya/ruri-v3-reranker-310m
WIKI_INGEST_MODE=wiki
WIKI_CONCURRENCY=4
WIKI_LINKER_ENABLED=true
WIKI_LINKER_MODE=neo
# Two hops only; the third value is omitted so 3-hop expansion is off (graph/linker/neo.py).
WIKI_LINKER_HOP_CAPS=30,20
# Only knob that costs chat calls: LLM calls/chunk = ceil(this/4) + entity candidates.
WIKI_LINKER_EDGE_CANDIDATES=8
WIKI_LINKER_EDGES_PER_TARGET=3
WIKI_LINKER_SCREEN_CANDIDATES=40
WIKI_LINKER_VERIFY_TOP=10
# Cost-free: how many kept links may become visible.
WIKI_LINKER_CURATE_KEEP=10
WIKI_LINKER_FOOTER_MAX=18
# 0 = no per-candidate LLM second opinion (each one was an extra chat call).
WIKI_LINKER_TIEBREAK_FLOOR=0
# Inline slots: WIKI_LINKER_INLINE_MAX / _INLINE_MAX_BIG / _INLINE_MAX_NEO.
WIKI_REQUEST_TIMEOUT=900
WIKI_OUTPUT_LANGUAGE="Japanese (日本語)"
WIKI_JEV_ENABLED=1
WIKI_JEV_BACKEND=gguf
# WIKI_JEV_BASE_URL=http://10.160.144.101:51023
# WIKI_JEV_BASE_URL=http://10.160.152.38:51023
# 8-bit GGUF on llama.cpp (jev-score built with build_jev_score.sh against CUDA llama.cpp).
# Q8_0 and Q4_K_M both run on INT8 tensor cores (Blackwell and Hopper); Q8_0 measured ~3% faster
# than Q4_K_M on an RTX 5060 Ti and is the closer match to full precision.
# many_mode=batched: all questions about one state are scored in one decode of that state.
# Back to PyTorch: WIKI_JEV_BACKEND=local (uses WIKI_JEV_LOCAL_PATH, DEVICE, DTYPE below).
WIKI_JEV_GGUF_LOCAL_PATH=/mnt/common/Code/local-llm/models/chaoliangUNSW/Jev-Style-0.8B-Decision-v3-GGUF
WIKI_JEV_GGUF_QUANT=Q8_0
WIKI_JEV_GGUF_MANY_MODE=batched
# One jev-score call per linker stage: screen/verify now share a state, so keep the whole
# stage inside a single engine batch (default 64 would split a 40+40 screen in two).
WIKI_JEV_MAX_BATCH_REQUESTS=128
WIKI_JEV_SCORE_BIN=/mnt/common/Code/local-llm/models/chaoliangUNSW/Jev-Style-0.8B-Decision-v3-GGUF/build/jev-score
WIKI_JEV_LOCAL_PATH=chaoliangUNSW/Jev-Style-0.8B-Decision-v3
WIKI_JEV_THRESHOLD=0.5
WIKI_JEV_SEED_THRESHOLD=0.5
WIKI_SUBAGENT_CONCURRENCY=6
WIKI_MAX_PAGE_FETCHES_PER_RUN=192
WIKI_JEV_SUBAGENT_GROUPS=16
WIKI_SUBAGENT_MAX_READS=10
WIKI_SUBAGENT_MIN_READS=4
WIKI_SUBAGENT_MAX_STEPS=30
WIKI_JEV_PREFILTER_MIN_OVERLAP=2

# Local Jev runtime: pin the GPU so a missing/invisible CUDA device fails loudly at
# startup instead of silently scoring ~30x slower on CPU. bfloat16 halves memory and
# time vs the runtime's float32 default; it drops to float16 automatically on GPUs
# without bf16. Revert to auto only if you want CPU scoring back on purpose.
WIKI_JEV_DEVICE=cuda
WIKI_JEV_DTYPE=bfloat16

WIKI_CHAT_API_KEY=local

WIKI_SEARCH_TRACE_DIR=/home/seigyo/llm-wiki/logs/traces
WIKI_USAGE_LOG_PATH=/home/seigyo/llm-wiki/logs/usage
