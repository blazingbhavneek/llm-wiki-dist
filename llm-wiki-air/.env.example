WIKI_DATA_ROOT=./data
WIKI_PARSER_BASE_URL=http://127.0.0.1:8000
WIKI_PARSER_TIMEOUT=7200
WIKI_CHAT_BASE_URL=http://127.0.0.1:8000/v1
WIKI_CHAT_API_KEY=local
WIKI_CHAT_MODEL=gemma-4-12B
WIKI_INGEST_MODE=wiki
WIKI_OUTPUT_LANGUAGE=Japanese (日本語)
WIKI_SECTION_TARGET_LINES=80
WIKI_WRITE_ATTEMPTS=3
WIKI_REWRITE_CONCURRENCY=1
WIKI_LINKER_ENABLED=true
WIKI_LINKER_MODE=legacy
WIKI_LINKER_CONCURRENCY=1
WIKI_EMBED_BACKEND=server
WIKI_EMBED_BASE_URL=http://127.0.0.1:8001/v1
WIKI_EMBED_API_KEY=local
WIKI_EMBED_MODEL=cl-nagoya/ruri-v3-30m
WIKI_EMBED_DIM=256
GROWI_URL=
GROWI_TOKEN=
GROWI_WRITE_PATH=/wiki
GROWI_ROOT_PATH=/wiki
GROWI_MODE=attach
GROWI_TIMEOUT=30
PUBLISHER_INTERVAL_SECONDS=60
