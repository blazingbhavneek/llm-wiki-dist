# Runtime configuration. Copy to .env before building/running the image.
# The repository .env is included in the image by policy for this deployment.
URL_PREFIX=

LLM_BASE_URL=http://llm.example/v1
LLM_API_KEY=local
LLM_MODEL=gemma-4-31B
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_IMAGE_MAX_PIXELS=16000000

# Required external MinerU v4 API; this image does not run MinerU locally.
MINERU_API_URL=http://mineru.example
MINERU_API_TIER=advanced
MINERU_TIMEOUT_SECONDS=1800

PANDOC_COMMAND=pandoc
PANDOC_TIMEOUT_SECONDS=300
XLSX_RECALCULATE_FORMULAS=auto
LIBREOFFICE_TIMEOUT_SECONDS=300
VECTOR_IMAGE_CONVERSION=auto
XLSX_MAX_TABLE_CELLS=50000
MAX_UPLOAD_BYTES=104857600
