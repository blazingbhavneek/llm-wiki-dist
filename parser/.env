# Serve every route under this prefix, e.g. /aaa/bbb -> http://host:port/aaa/bbb/
# Blank or unset means no prefix. main.py also bakes it into the frontend.
URL_PREFIX=/agent/doc-parser/

# OpenAI-compatible local vision endpoint. Request headers can override these.
LLM_BASE_URL=http://10.160.144.101:51029/v1
LLM_API_KEY=local
LLM_MODEL=gemma-4-31B
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
# Images sent to the vision endpoint are normalized to PNG and bounded by pixels.
LLM_IMAGE_MAX_PIXELS=16000000

# MinerU CLI executed inside the GPU worker.
MINERU_COMMAND=mineru
# pipeline (default) is general-purpose and cold-loads fast; vlm-engine /
# hybrid-engine are higher accuracy but pull in vLLM and a multi-minute init.
MINERU_BACKEND=pipeline
# Pipeline does not benefit from the warm VLM service.
MINERU_API_SERVICE=false
# Physical CUDA device index. Single-GPU hosts want 0.
MINERU_CUDA_VISIBLE_DEVICES=1
# Pages processed concurrently by the GPU worker. Raise for throughput if the
# GPU has VRAM headroom; lower it if vLLM OOMs.
MINERU_PROCESSING_WINDOW_SIZE=4
MINERU_TIMEOUT_SECONDS=1800
# vLLM memory fraction - only used by the vlm/hybrid backends, ignored by pipeline.
# MINERU_GPU_MEMORY_UTILIZATION=0.1
# MinerU API stdout/stderr; rotates at 10 MiB and keeps 3 backups.
MINERU_API_LOG_PATH=logs/mineru-api.log
MINERU_API_LOG_MAX_BYTES=10485760
MINERU_API_LOG_BACKUP_COUNT=3
# MINERU_VENV_BIN=/path/to/venv/bin
# MINERU_EXTRA_ARGS=

# Pandoc CLI executed inside the external worker pool.
PANDOC_COMMAND=pandoc
PANDOC_TIMEOUT_SECONDS=300
# PANDOC_EXTRA_ARGS=

# Recalculate formulas with LibreOffice when it is installed. Set to false to
# disable, or required to reject workbooks when recalculation is unavailable.
XLSX_RECALCULATE_FORMULAS=auto
# LIBREOFFICE_COMMAND=/usr/bin/libreoffice
LIBREOFFICE_TIMEOUT_SECONDS=300

# Convert EMF/WMF images from DOCX/PPTX/XLSX to PNG with LibreOffice so they
# can be embedded and described. Set to false to disable, or required to fail
# the request when conversion is unavailable.
VECTOR_IMAGE_CONVERSION=auto

# Switch very large/sparse worksheets from a rectangular table to a cell list.
XLSX_MAX_TABLE_CELLS=50000
